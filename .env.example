POSTGRES_USER=ai_mail
POSTGRES_PASSWORD=replace-with-a-local-secret
POSTGRES_DB=ai_mail
DATABASE_URL=postgresql://ai_mail:replace-with-a-local-secret@postgres:5432/ai_mail?schema=public
PORT=3000
LOG_LEVEL=info
BUSINESS_TIMEZONE=Europe/Rome
# Dashboard first user. The account is created once when it does not exist; an existing password is never overwritten.
DASHBOARD_INITIAL_EMAIL=admin@example.invalid
DASHBOARD_INITIAL_PASSWORD=
# Set true only when Dashboard is served over HTTPS.
DASHBOARD_SECURE_COOKIE=false
# Optional self-hosted IMAP settings. Generate keys locally before enabling:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Set all IMAP_* values together; use a separate random 32-byte encryption key and API token.
# Zimbra/TSnet defaults; replace for another IMAP server.
# IMAP_HOST=imap.tsnet.it
# IMAP_PORT=993
# IMAP_TLS_MODE=implicit
# IMAP_EMAIL=you@example.com
# IMAP_USERNAME=you@example.com
# IMAP_PASSWORD=replace-with-app-password
# IMAP_MAILBOX=INBOX
# IMAP_SYNC_FOLDERS=INBOX,Sent,Archive
# IMAP_SYNC_HISTORY_MONTHS=12
# IMAP_SYNC_PAGE_SIZE=5
# IMAP_POLL_INTERVAL_SECONDS=60
# PostgreSQL-backed project analysis worker poll interval (seconds; minimum 10).
PROJECT_ANALYSIS_POLL_INTERVAL_SECONDS=30
# Physically remove local mail missing from a complete IMAP folder snapshot.
# Runs every 4 hours by default; set interval to 1-24 hours. Trash is not a retention folder.
MAIL_DELETION_SYNC_ENABLED=true
MAIL_DELETION_SYNC_INTERVAL_HOURS=4
# IMAP_API_TOKEN=replace-with-a-long-random-token
# CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# Zimbra/TSnet SMTP endpoint for a future explicitly authorized send feature:
# SMTP_HOST=smtp.tsnet.it
# SMTP_PORT=587
# SMTP_TLS_MODE=starttls
# SMTP sending is not implemented; do not add live credentials here.
# Optional M8 analyzer. Only OpenAI is currently implemented; model is configurable.
AI_PROVIDER=openai
AI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Ignored for GPT-4.x / GPT-4o / GPT-3.5 models; applies to reasoning models.
AI_REASONING_EFFORT=medium
AI_TIMEOUT_MS=20000
AI_RETRY_COUNT=1
AI_CONTEXT_MAX_CHARS=18000
# Only configured channels + recipients may enter the durable notification queue.
NOTIFICATION_ALLOWED_CHANNELS=telegram
NOTIFICATION_ALLOWED_RECIPIENTS=
# Local CLI/MCP clients read these from their process environment.
# AI_MAIL_API_URL=http://localhost:3000/api/v1
# AI_MAIL_API_TOKEN=use-the-same-secret-as-IMAP_API_TOKEN

# Ai Mail's optional Telegram bridge. Leave disabled unless a Telegram bot is intended.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=
AGENT_EVENT_WEBHOOK_URL=
AGENT_CHAT_WEBHOOK_URL=
# Optional OpenClaw-native WhatsApp notification sender; enable only with a reviewed recipient allowlist.
OPENCLAW_WHATSAPP_NOTIFY_URL=
# Use a random secret shared with the Agent webhook receiver (minimum 24 characters).
AGENT_WEBHOOK_TOKEN=
# For a local OpenClaw container, use http://host.docker.internal:18789/hooks/ai-mail-event
AI_MAIL_PUBLIC_API_URL=http://localhost:3000/api/v1
DAILY_BRIEF_ENABLED=false
DAILY_BRIEF_TIME=09:00
# M17 preferences; the brief remains disabled unless explicitly enabled above.
DAILY_BRIEF_LANGUAGE=zh-CN
DAILY_BRIEF_STYLE=concise
DAILY_BRIEF_WAITING_THRESHOLD_DAYS=7
DAILY_BRIEF_FOLLOW_UP_WINDOW_DAYS=7
DAILY_BRIEF_NOTIFY_WHEN_EMPTY=false
# M15: repairs missing IMAP imports/processing records and reruns idempotent CRM resolution once per business day.
MAIL_RECONCILIATION_ENABLED=true
MAIL_RECONCILIATION_TIME=05:00
