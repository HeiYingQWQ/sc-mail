#!/bin/sh
# Main is updated only by reviewed PR merges; local pushes target work branches.
zero=0000000000000000000000000000000000000000
while read -r local_ref local_oid remote_ref remote_oid; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo 'Direct pushes to main are blocked. Push a feature/fix branch and merge a reviewed PR after CI passes.' >&2
    exit 1
  fi
  case "$remote_ref" in
    refs/heads/feature/*|refs/heads/fix/*) ;;
    refs/heads/*)
      echo 'Work branches must use feature/* or fix/*.' >&2
      exit 1
      ;;
    *) continue ;;
  esac
  # New work branches and deletion of work branches have no ancestry to check.
  if [ "$remote_oid" = "$zero" ] || [ "$local_oid" = "$zero" ]; then
    continue
  fi
  if ! git cat-file -e "$remote_oid^{commit}" 2>/dev/null; then
    echo 'Fetch the remote work branch before updating it; its current commit is not available locally.' >&2
    exit 1
  fi
  if ! git merge-base --is-ancestor "$remote_oid" "$local_oid"; then
    echo 'Non-fast-forward work branch pushes are blocked. Integrate the remote changes without force push.' >&2
    exit 1
  fi
done
