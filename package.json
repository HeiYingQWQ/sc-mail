{
  "name": "sc-mail",
  "version": "0.1.0",
  "private": true,
  "description": "SC Mail business email service",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.19.0",
  "bin": {
    "ai-mail": "scripts/ai-mail.mjs"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "start:worker": "cross-env APP_ROLE=worker node dist/main.js",
    "ai-mail": "node scripts/ai-mail.mjs",
    "openclaw:enable-whatsapp-notifications": "node openclaw-stack/enable-whatsapp-notifications.mjs",
    "backup": "node scripts/backup.mjs",
    "backfill:automation-details": "node scripts/backfill-automation-details.cjs",
    "verify:backup-restore": "node scripts/verify-backup-restore.mjs",
    "verify:integration": "node scripts/verify-integration.mjs",
    "verify:review-fixes": "node scripts/verify-review-fixes.cjs",
    "verify:dashboard": "node scripts/verify-dashboard.cjs",
    "verify:tool-contracts": "node scripts/verify-tool-contracts.mjs",
    "verify:sync-recovery": "node scripts/verify-sync-recovery.cjs",
    "verify:triage-lease": "node scripts/verify-triage-lease.cjs",
    "prisma:validate": "prisma validate",
    "typecheck": "tsc --noEmit",
    "verify:normalizer": "node scripts/verify-mail-normalizer.cjs",
    "verify:business-gate": "node scripts/verify-business-gate.cjs",
    "verify:sync-cursor": "node scripts/verify-sync-cursor.cjs",
    "verify:contact-resolver": "node scripts/verify-contact-resolver.cjs",
    "verify:crm-delete": "node scripts/verify-crm-delete.cjs",
    "verify:crm-cli-http": "cross-env UI_CRM_ALLOW_LOCAL_DB_CREATE=1 UI_CRM_RUN_CLI_SUITE=1 node scripts/run-ui-crm-acceptance.cjs",
    "verify:project-review": "node scripts/verify-project-review.cjs",
    "verify:manual-crm": "node scripts/verify-manual-crm.cjs",
    "verify:system-mail-senders": "node scripts/verify-system-mail-senders.cjs",
    "verify:project-analysis": "node scripts/verify-project-analysis.cjs",
    "verify:project-analysis-evidence": "node scripts/verify-project-analysis-evidence.cjs",
    "probe:project-analysis-provider": "node scripts/probe-project-analysis-provider.cjs",
    "verify:ai-analysis": "node scripts/verify-ai-analysis.cjs",
    "verify:importance-triage": "node scripts/verify-importance-triage.cjs",
    "verify:task-state": "node scripts/verify-task-state.cjs",
    "prisma:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.19.0",
    "html-to-text": "10.0.1",
    "imapflow": "^2.0.6",
    "joi": "^17.13.3",
    "mailparser": "^3.9.28",
    "nestjs-pino": "^4.4.0",
    "pg-boss": "12.32.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.0.0",
    "cross-env": "^7.0.3",
    "prisma": "^6.19.0",
    "typescript": "^5.8.3"
  }
}
